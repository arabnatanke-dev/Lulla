{
  "expo": {
    "name": "Lulla",
    "slug": "lolli",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/lulla-icon.png",
    "scheme": "lulla",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lulla.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14264C",
        "foregroundImage": "./assets/images/lulla-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 6,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "app.lulla.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lulla-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lulla-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#101B3F",
          "dark": {
            "backgroundColor": "#101B3F"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f485bc0b-25b4-4c7b-9893-4e64c5e041a3"
      }
    },
    "owner": "arabnatanke-team"
  }
}
