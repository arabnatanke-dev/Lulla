# Зависимости устанавливаются заново на сервере EAS.
node_modules/

# Локальные кэши и результаты предыдущих сборок не нужны в APK-архиве.
.expo/
dist/
web-build/
.git/
.vscode/

# Нативные папки создаются автоматически из конфигурации Expo.
ios/
android/
.kotlin/

# Локальные и секретные файлы не отправляются на сервер сборки.
.DS_Store
*.log
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env*.local
*.tsbuildinfo

# Учебный шаблон Expo не является частью приложения.
app-example/
